[Unit]
Description=Nexus Docker metrics collector
Requires=nexus-docker-gate.socket
After=nexus-docker-gate.socket docker.service

[Service]
Type=simple
User=nexus-docker
Group=nexus
WorkingDirectory=/opt/nexus/current
EnvironmentFile=-/etc/nexus/docker.env
Environment=PYTHONDONTWRITEBYTECODE=1
RuntimeDirectory=nexus-docker
RuntimeDirectoryMode=0750
ExecStart=/opt/nexus/current/.venv/bin/python -m nexus.docker_collector
Restart=on-failure
RestartSec=4
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
InaccessiblePaths=-/run/docker.sock -/run/containerd/containerd.sock
UMask=0027
TasksMax=12
MemoryMax=85M

[Install]
WantedBy=multi-user.target
