# Production requires the exact HTTPS browser origin, with no trailing slash.
NEXUS_ORIGIN=https://nexus.example-tailnet.ts.net
NEXUS_DEVELOPMENT=false
NEXUS_ADMIN_NAME=admin
NEXUS_SESSION_HOURS=12

NEXUS_STATE_DIR=var
NEXUS_WORKSPACE_CONFIG=config/workspaces.toml
NEXUS_FRONTEND_DIR=frontend/dist

NEXUS_METRIC_INTERVAL=4
NEXUS_PERSIST_INTERVAL=20
NEXUS_RAW_HOURS=30
NEXUS_HISTORY_DAYS=8
NEXUS_DISK_PATH=/
# An empty list sums all non-loopback interfaces. Specify the VPS uplink to avoid double counting.
NEXUS_NETWORK_INTERFACES=[]
NEXUS_SERVICES=[]
NEXUS_DOCKER_ENABLED=false
NEXUS_DOCKER_SNAPSHOT=/run/nexus-docker/snapshot.json

NEXUS_MAX_FILE_BYTES=1048576
NEXUS_REVISIONS_PER_FILE=20
NEXUS_REVISION_BUDGET_MB=128
